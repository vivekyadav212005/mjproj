  "systems": {
    "S0": "undefended baseline (no classifier at any layer)",
    "S1": "RuleClassifier only",
    "S2": "persisted retrained TF-IDF + Logistic Regression, threshold 0.40",
    "S3": "RuleClassifier OR persisted retrained TF-IDF/LR"
  },
  "systems_run": [
    "S0",
    "S1",
    "S2",
    "S3"
  ],
  "system_specs": {
    "S0": {
      "system": "S0",
      "classifier": "none_undefended",
      "defended": false,
      "spec": {
        "type": "none",
        "note": "undefended baseline: no query gate, no document scan, no follow-up scan, no output filter"
      }
    },
    "S1": {
      "system": "S1",
      "classifier": "RuleClassifier",
      "defended": true,
      "spec": {
        "type": "rule",
        "module": "security.rule_classifier.RuleClassifier",
        "groups": [
          "G1:0.95",
          "G2:0.90",
          "G3:0.85",
          "G4:0.80",
          "G5:0.65"
        ],
        "threshold": 0.5
      }
    },
    "S2": {
      "system": "S2",
      "classifier": "TFIDF_LR_persisted",
      "defended": true,
      "spec": {
        "type": "ml",
        "model": "TF-IDF + LogisticRegression (persisted)",
        "path": "security/training/s2_tfidf_lr.joblib",
        "threshold": 0.4,
        "threshold_in_bundle": 0.4,
        "threshold_selection_rule": "max validation F1 among thresholds with FPR <= 0.05",
        "tfidf": {
          "ngram_range": [
            1,
            2
          ],
          "min_df": 2,
          "max_df": 0.95,
          "max_features": 50000,
          "sublinear_tf": true
        },
        "logreg": {
          "C": 1.0,
          "class_weight": "balanced",
          "max_iter": 1000,
          "solver": "lbfgs",
          "random_state": 42
        }
      }
    },
    "S3": {
      "system": "S3",
      "classifier": "Rule_OR_TFIDF_LR",
      "defended": true,
      "spec": {
        "type": "union",
        "rule": {
          "type": "rule",
          "module": "security.rule_classifier.RuleClassifier",
          "groups": [
            "G1:0.95",
            "G2:0.90",
            "G3:0.85",
            "G4:0.80",
            "G5:0.65"
          ],
          "threshold": 0.5
        },
        "ml": {
          "type": "ml",
          "model": "TF-IDF + LogisticRegression (persisted)",
          "path": "security/training/s2_tfidf_lr.joblib",
          "threshold": 0.4,
          "threshold_in_bundle": 0.4,
          "threshold_selection_rule": "max validation F1 among thresholds with FPR <= 0.05",
          "tfidf": {
            "ngram_range": [
              1,
              2
            ],
            "min_df": 2,
            "max_df": 0.95,
            "max_features": 50000,
            "sublinear_tf": true
          },
          "logreg": {
            "C": 1.0,
            "class_weight": "balanced",
            "max_iter": 1000,
            "solver": "lbfgs",
            "random_state": 42
          }
        },
        "combination": "blocked = rule.blocked OR ml.blocked",
        "note": "disjunction only; no weighted score, no extra thresholds"
      }
    }
  },
